{
  "expo": {
    "name": "Lucid",
    "slug": "Lucid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chrisvkang.lucid"
    },
    "android": {
      "package": "com.chrisvkang.lucid",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Lucid uses the microphone to record your dreams."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lucid uses the microphone to record your dreams and show the words as you speak.",
          "speechRecognitionPermission": "Lucid turns your voice into text on this device while you tell your dream."
        }
      ],
      "expo-asset"
    ]
  }
}
